---
import type { ServiceArea } from '@/data/offerings';
import { useTranslations, type Lang } from '@i18n/utils';

interface Props {
  area: ServiceArea;
  lang: Lang;
  /** `compact` for the homepage grid, `full` for the /services page. */
  variant?: 'compact' | 'full';
}

const { area, lang, variant = 'compact' } = Astro.props;
const t = useTranslations(lang);
---

<article id={area.slug} class="surface-card flex flex-col p-6 scroll-mt-24">
  <h3 class="text-lg font-semibold tracking-tight">{area.title[lang]}</h3>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-secondary">{area.body[lang]}</p>

  {
    variant === 'full' && (
      <>
        <p class="eyebrow mt-6 text-[11px]">{t('services.capabilitiesLabel')}</p>
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {area.capabilities.map((capability) => (
            <li class="tag">{capability[lang]}</li>
          ))}
        </ul>
        <p class="mt-5 border-t border-subtle pt-4 text-xs leading-relaxed text-muted">
          {area.scopeNote[lang]}
        </p>
      </>
    )
  }
</article>
