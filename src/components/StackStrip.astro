---
import { useTranslations, type Lang } from '@i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * Compressed replacement for the six-cluster StackGrid on the homepage, which
 * reviewers skipped as "wallpaper" — every tag in it already appeared on a
 * project card. Data and infrastructure lead, because that is what the hero
 * claims as the specialism. The full grid still renders on /about.
 */
const stack = [
  'PostgreSQL',
  'TimescaleDB',
  'Redis',
  'MQTT',
  'WebSockets',
  'Python',
  'TypeScript',
  'Node.js',
  'FastAPI',
  'Docker',
  'AWS',
  'CI/CD',
  'React',
  'Astro',
];
---

<div class="border-t border-subtle pt-8">
  <ul class="flex flex-wrap items-center gap-x-2 gap-y-2">
    {
      stack.map((item, index) => (
        <li class="flex items-center gap-2">
          <span class="font-mono text-sm text-secondary">{item}</span>
          {index < stack.length - 1 && (
            <span class="text-muted" aria-hidden="true">
              ·
            </span>
          )}
        </li>
      ))
    }
  </ul>
  <p class="mt-4 text-sm text-muted">{t('home.stackStripNote')}</p>
</div>
