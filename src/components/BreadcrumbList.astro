---
import { SITE } from '@/config';

interface Crumb {
  name: string;
  /** Absolute or site-relative path, e.g. `/en/work/` or `https://…`. */
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const site = Astro.site ?? new URL(SITE.url);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: new URL(item.href, site).toString(),
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
