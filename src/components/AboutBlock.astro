---
import CvLink from '@components/CvLink.astro';
import { PROFILE, SITE } from '@/config';
import { clients } from '@/data/clients';
import { localizePath, useTranslations, type Lang } from '@i18n/utils';

interface Props {
  lang: Lang;
  headline: string;
  summary: string;
}

const { lang, headline, summary } = Astro.props;
const t = useTranslations(lang);

const meta = [
  { label: t('about.meta'), value: t('profile.location') },
  { label: 'Timezone', value: PROFILE.timezone },
  { label: t('about.languages'), value: t('profile.languagesValue') },
  { label: t('about.seniority'), value: SITE.role[lang] },
];
---

<div class="grid gap-10 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-14">
  <div>
    {
      PROFILE.photo ? (
        <img
          src={PROFILE.photo}
          alt={SITE.name}
          width="208"
          height="208"
          class="aspect-square w-full max-w-[13rem] rounded-2xl border border-subtle object-cover"
        />
      ) : (
        <div class="surface-card grid aspect-square w-full max-w-[13rem] place-items-center p-5 text-center">
          <div>
            <div class="mx-auto grid h-20 w-20 place-items-center rounded-2xl bg-[var(--accent)] font-mono text-2xl font-bold text-ink-950">
              MC
            </div>
            <p class="mt-4 text-sm font-semibold tracking-tight">{SITE.name}</p>
            <p class="mt-1 text-sm text-secondary">{SITE.role[lang]}</p>
          </div>
        </div>
      )
    }
  </div>

  <div>
    <h2 class="text-[length:var(--text-section)] font-bold tracking-tight text-balance">
      {headline}
    </h2>

    <p class="mt-5 text-lg leading-relaxed text-secondary text-pretty">
      {summary}
    </p>

    <dl class="mt-8 grid gap-x-8 gap-y-4 sm:grid-cols-2">
      {
        meta.map((item) => (
          <div>
            <dt class="eyebrow text-[11px]">{item.label}</dt>
            <dd class="mt-1.5 text-sm">{item.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-8">
      <p class="eyebrow text-[11px]">{t('about.clientsLabel')}</p>
      <ul class="mt-3 flex flex-wrap items-center gap-2">
        {
          clients.map((client) => (
            <li class="tag !px-3 !py-2 text-[0.76rem]">{client.name}</li>
          ))
        }
      </ul>
    </div>

    {/* States both intents plainly so neither audience has to guess. */}
    <p class="mt-8 rounded-lg border border-subtle bg-raised px-4 py-3 text-sm">
      {t('about.status')}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      <CvLink lang={lang} />
      <a href={localizePath(lang, 'about')} class="link-accent text-sm">
        {t('about.fullBackground')} →
      </a>
      <a href={localizePath(lang, 'services')} class="text-sm text-muted transition-colors hover:text-[var(--text-primary)]">
        {t('about.servicesDoor')} →
      </a>
    </div>
  </div>
</div>
