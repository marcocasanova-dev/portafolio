---
import type { CollectionEntry } from 'astro:content';
import {
  formatDate,
  localizePath,
  splitLocaleId,
  useTranslations,
  type Lang,
} from '@i18n/utils';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}

const { post, lang } = Astro.props;
const { slug } = splitLocaleId(post.id);
const { data } = post;
const t = useTranslations(lang);

const href = localizePath(lang, `blog/${slug}`);
---

<article
  class="surface-card group relative flex flex-col overflow-hidden transition-all duration-300 hover:-translate-y-0.5 hover:border-[var(--accent)]/50 hover:shadow-xl"
>
  {
    data.image && (
      <div class="aspect-[16/9] overflow-hidden border-b border-subtle bg-ink-100 dark:bg-ink-850">
        <img
          src={data.image}
          alt=""
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center gap-2 font-mono text-[11px] text-muted">
      <time datetime={data.pubDate.toISOString()}>
        {formatDate(data.pubDate, lang)}
      </time>
      <span aria-hidden="true">·</span>
      <span>{data.readTime} {t('blog.readTime')}</span>
    </div>

    <h2 class="mt-3 leading-snug font-semibold tracking-tight">
      <a href={href} class="after:absolute after:inset-0 after:content-['']">
        {data.title}
      </a>
    </h2>

    <p class="mt-2.5 flex-1 text-sm leading-relaxed text-secondary">
      {data.description}
    </p>

    {
      data.tags.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-1.5">
          {data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }
  </div>
</article>
