---
import { processSteps } from '@/data/offerings';
import type { Lang } from '@i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<ol class="mt-10 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-subtle bg-[var(--border-subtle)] sm:grid-cols-2 lg:grid-cols-4">
  {
    processSteps.map((step, index) => (
      <li class="bg-raised p-6">
        <span class="font-mono text-xs text-muted">{String(index + 1).padStart(2, '0')}</span>
        <h3 class="mt-2 font-semibold tracking-tight">{step.title[lang]}</h3>
        <p class="mt-2 text-sm leading-relaxed text-secondary">{step.body[lang]}</p>
      </li>
    ))
  }
</ol>
