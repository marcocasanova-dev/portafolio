---
import { languages, localizePath, switchLangPath, useTranslations, type Lang } from '@i18n/utils';

interface Props {
  lang: Lang;
  /**
   * Set on a page that has no real /es/ or /de/ sibling yet (e.g. an
   * English-only SEO landing page) — switching locale then goes to this
   * path under the target locale instead of `switchLangPath`, which would
   * otherwise point at a 404. E.g. `fallbackPath="services"` sends the ES
   * button to /es/services/ rather than /es/services/this-exact-slug/.
   */
  fallbackPath?: string;
}

const { lang, fallbackPath } = Astro.props;
const t = useTranslations(lang);

const options = (Object.keys(languages) as Lang[]).map((code) => {
  let href: string;
  if (code === lang) {
    // The current-language button always links to this exact page — never
    // through switchLangPath, which assumes a `/<lang>/...` prefix that a
    // route like /404 (no locale segment at all) does not have.
    href = Astro.url.pathname;
  } else if (fallbackPath !== undefined) {
    href = localizePath(code, fallbackPath);
  } else {
    href = switchLangPath(Astro.url, code);
  }
  return { code, label: languages[code], href, isCurrent: code === lang };
});
---

{/*
  Plain links rather than a JS dropdown: crawlable, works without JS, and keeps
  the alternate-locale URLs in the markup for SEO.
*/}
<div
  class="flex items-center rounded-lg border border-subtle p-0.5"
  role="group"
  aria-label={t('lang.switch')}
>
  {
    options.map((option) => (
      <a
        href={option.href}
        hreflang={option.code}
        aria-current={option.isCurrent ? 'true' : undefined}
        class:list={[
          'rounded-md px-2 py-1 font-mono text-[11px] font-medium uppercase transition-colors',
          // Inverted ink rather than accent fill: at 11px this is small text,
          // so it needs 4.5:1, which accent-700 on ink-950 does not clear.
          option.isCurrent
            ? 'bg-ink-950 text-ink-50 dark:bg-ink-50 dark:text-ink-950'
            : 'text-muted hover:text-[var(--text-primary)]',
        ]}
      >
        {option.code}
      </a>
    ))
  }
</div>
