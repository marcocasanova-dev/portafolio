---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  /** Optional "view all" style link rendered on the right. */
  actionLabel?: string;
  actionHref?: string;
}

const { eyebrow, title, subtitle, actionLabel, actionHref } = Astro.props;
---

<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div class="max-w-2xl">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="mt-2 text-[length:var(--text-section)] font-bold tracking-tight">
      {title}
    </h2>
    {
      subtitle && (
        <p class="mt-3 leading-relaxed text-secondary">{subtitle}</p>
      )
    }
  </div>

  {
    actionLabel && actionHref && (
      <a
        href={actionHref}
        class="group inline-flex shrink-0 items-center gap-1.5 font-mono text-sm text-[var(--accent)]"
      >
        {actionLabel}
        <span
          class="transition-transform group-hover:translate-x-0.5"
          aria-hidden="true"
        >
          →
        </span>
      </a>
    )
  }
</div>
