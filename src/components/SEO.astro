---
import { SITE } from '@/config';
import { languages, localeCodes, switchLangPath, type Lang } from '@i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Path relative to /public, or an absolute URL. */
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  modifiedDate?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description,
  lang,
  image = SITE.ogImage,
  type = 'website',
  publishedDate,
  modifiedDate,
  tags = [],
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site);
const ogImage = new URL(image, site);

// One <link rel="alternate"> per locale, plus x-default pointing at English.
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  hreflang: localeCodes[code],
  href: new URL(switchLangPath(Astro.url, code), site).toString(),
}));

const fullTitle =
  title === SITE.name ? `${SITE.name} — ${SITE.role[lang]}` : `${title} · ${SITE.name}`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: site.toString(),
  jobTitle: SITE.role[lang],
  email: `mailto:${SITE.email}`,
  sameAs: [SITE.github, SITE.linkedin].filter(Boolean),
};

const articleSchema =
  type === 'article' && publishedDate
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImage.toString(),
        datePublished: publishedDate.toISOString(),
        dateModified: (modifiedDate ?? publishedDate).toISOString(),
        author: { '@type': 'Person', name: SITE.name, url: site.toString() },
        publisher: { '@type': 'Person', name: SITE.name },
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.toString() },
        keywords: tags.join(', '),
        inLanguage: localeCodes[lang],
      }
    : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.name} />
<link rel="canonical" href={canonical} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

{
  alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))
}
<link
  rel="alternate"
  hreflang="x-default"
  href={alternates.find((a) => a.code === 'en')?.href}
/>

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={localeCodes[lang].replace('-', '_')} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{
  publishedDate && (
    <meta
      property="article:published_time"
      content={publishedDate.toISOString()}
    />
  )
}
{
  modifiedDate && (
    <meta
      property="article:modified_time"
      content={modifiedDate.toISOString()}
    />
  )
}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.name} — Blog`}
  href={new URL(`/rss-${lang}.xml`, site)}
/>

<script
  type="application/ld+json"
  set:html={JSON.stringify(personSchema)}
  is:inline
/>
{
  articleSchema && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(articleSchema)}
      is:inline
    />
  )
}
