---
import BaseLayout from '@layouts/BaseLayout.astro';
import BreadcrumbList from '@components/BreadcrumbList.astro';
import ProjectShowcase from '@components/ProjectShowcase.astro';
import { collectSectors, getProjects } from '@/lib/content';
import { languages, localizePath, useTranslations, type Lang } from '@i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const projects = await getProjects(lang);
const sectors = collectSectors(projects);

const breadcrumbs = [
  { name: t('nav.home'), href: localizePath(lang) },
  { name: t('nav.work'), href: localizePath(lang, 'work') },
];
---

<BaseLayout lang={lang} title={t('seo.workTitle')} description={t('work.subtitle')}>
  <BreadcrumbList items={breadcrumbs} />

  <div class="container-page py-16 md:py-20">
    <header class="max-w-2xl">
      <p class="eyebrow">{t('work.title')}</p>
      <h1 class="mt-3 text-[length:var(--text-hero)] leading-[1.05] font-bold tracking-[-0.03em]">
        {t('work.title')}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-secondary text-pretty">
        {t('work.subtitle')}
      </p>
      <p class="mt-3 text-sm text-muted">{t('work.disclosure')}</p>
    </header>

    {
      sectors.length > 0 && (
        <div
          class="mt-10 flex flex-wrap gap-2"
          role="group"
          aria-label={t('work.title')}
        >
          <button
            type="button"
            class="filter-btn tag is-active"
            data-sector="all"
            aria-pressed="true"
          >
            {t('work.filterAll')}
          </button>
          {sectors.map((sector) => (
            <button
              type="button"
              class="filter-btn tag"
              data-sector={sector}
              aria-pressed="false"
            >
              {sector}
            </button>
          ))}
        </div>
      )
    }

    <div id="project-grid">
      <div class="mt-10 grid gap-6">
        {projects.map((project, i) => (
          <div data-sectors={JSON.stringify(project.data.sectors)}>
            <ProjectShowcase project={project} lang={lang} index={i + 1} />
          </div>
        ))}
      </div>
    </div>

    <p id="empty-state" class="hidden py-16 text-center text-muted">
      {t('work.empty')}
    </p>
  </div>
</BaseLayout>

<style>
  .filter-btn {
    cursor: pointer;
    transition:
      background-color 150ms ease,
      color 150ms ease,
      border-color 150ms ease;
  }

  .filter-btn.is-active {
    background-color: var(--accent);
    border-color: var(--accent);
    /* accent-700 (light mode) is too dark for near-black text at 4.5:1 —
       white clears it; accent-400 (dark mode) is light enough that ink-950
       clears it instead. Same fix as the Header logo mark. */
    color: white;
    font-weight: 600;
  }

  :global(.dark) .filter-btn.is-active {
    color: var(--color-ink-950);
  }
</style>

<script>
  // Progressive enhancement: without JS every project stays visible.
  const buttons =
    document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  // Descendant selector (not `>`) — cards may sit inside a Featured/Additional
  // <section data-project-group> wrapper, not directly under the grid.
  const cards = document.querySelectorAll<HTMLElement>(
    '#project-grid [data-sectors]'
  );
  const groups = document.querySelectorAll<HTMLElement>('[data-project-group]');
  const emptyState = document.getElementById('empty-state');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const selected = button.dataset.sector ?? 'all';

      buttons.forEach((other) => {
        const active = other === button;
        other.classList.toggle('is-active', active);
        other.setAttribute('aria-pressed', String(active));
      });

      let visible = 0;
      cards.forEach((card) => {
        const sectors: string[] = JSON.parse(card.dataset.sectors ?? '[]');
        const show = selected === 'all' || sectors.includes(selected);
        card.hidden = !show;
        if (show) visible++;
      });

      // Hide a Featured/Additional heading if the filter left it empty.
      groups.forEach((group) => {
        const groupHasVisible = Array.from(
          group.querySelectorAll<HTMLElement>('[data-sectors]')
        ).some((card) => !card.hidden);
        group.hidden = !groupHasVisible;
      });

      emptyState?.classList.toggle('hidden', visible > 0);
    });
  });
</script>
