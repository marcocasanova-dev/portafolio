---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import StackGrid from '@components/StackGrid.astro';
import CvLink from '@components/CvLink.astro';
import { PROFILE, SITE } from '@/config';
import { clients } from '@/data/clients';
import { languages, localizePath, useTranslations, type Lang } from '@i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// Collection ids are bare locale codes (`en.md` -> id `en`).
const entry = await getEntry('about', lang);
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

<BaseLayout
  lang={lang}
  title={t('about.title')}
  description={entry?.data.summary ?? SITE.role[lang]}
>
  <div class="container-page py-16 md:py-20">
    <header class="grid gap-10 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-14">
      <div>
        {
          PROFILE.photo ? (
            <img
              src={PROFILE.photo}
              alt={SITE.name}
              width="208"
              height="208"
              class="aspect-square w-full max-w-[13rem] rounded-2xl border border-subtle object-cover"
            />
          ) : (
            <div class="surface-card grid aspect-square w-full max-w-[13rem] place-items-center p-5 text-center">
              <div>
                <div class="mx-auto grid h-20 w-20 place-items-center rounded-2xl bg-[var(--accent)] font-mono text-2xl font-bold text-ink-950">
                  MC
                </div>
                <p class="mt-4 text-sm font-semibold tracking-tight">{SITE.name}</p>
                <p class="mt-1 text-sm text-secondary">{SITE.role[lang]}</p>
              </div>
            </div>
          )
        }
      </div>

      <div>
        <p class="eyebrow">{t('about.title')}</p>
        <h1
          class="mt-3 text-[length:clamp(2rem,4.5vw,3.25rem)] leading-[1.1] font-bold tracking-[-0.03em] text-balance"
        >
          {entry?.data.headline ?? t('about.heading')}
        </h1>
        {
          entry && (
            <p class="mt-5 text-lg leading-relaxed text-secondary text-pretty">
              {entry.data.summary}
            </p>
          )
        }

        <dl class="mt-8 grid gap-x-8 gap-y-4 sm:grid-cols-3">
          <div>
            <dt class="eyebrow text-[11px]">{t('about.meta')}</dt>
            <dd class="mt-1.5 text-sm">{t('profile.location')}</dd>
          </div>
          <div>
            <dt class="eyebrow text-[11px]">{t('about.languages')}</dt>
            <dd class="mt-1.5 text-sm">{t('profile.languagesValue')}</dd>
          </div>
          <div>
            <dt class="eyebrow text-[11px]">{t('about.seniority')}</dt>
            <dd class="mt-1.5 text-sm">
              {SITE.role[lang]} · {PROFILE.timezone}
            </dd>
          </div>
        </dl>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <CvLink lang={lang} variant="button" />
          <a href={localizePath(lang, 'services')} class="link-accent text-sm">
            {t('about.servicesDoor')} →
          </a>
        </div>
      </div>
    </header>

    {
      Content && (
        <div class="mt-16 grid gap-12 lg:grid-cols-[13rem_minmax(0,46rem)] lg:gap-14">
          <div aria-hidden="true" />
          <div class="prose prose-lg min-w-0">
            <Content />
          </div>
        </div>
      )
    }

    <section class="mt-20">
      <p class="eyebrow">{t('about.clientsLabel')}</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {clients.map((client) => <li class="tag !px-3 !py-2 text-[0.76rem]">{client.name}</li>)}
      </ul>
    </section>

    <section class="mt-20">
      <h2 class="text-[length:var(--text-section)] font-bold tracking-tight">
        {t('about.stackTitle')}
      </h2>
      <StackGrid lang={lang} />
    </section>
  </div>
</BaseLayout>
