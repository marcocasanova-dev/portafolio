---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import {
  formatDate,
  localizePath,
  splitLocaleId,
  useTranslations,
  type Lang,
} from '@i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const { lang, slug } = splitLocaleId(post.id);
    return { params: { lang, slug }, props: { post } };
  });
}

const { post } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { Content, headings } = await render(post);
const { data } = post;

// h2s only — deep nesting makes the sidebar noisier than the article.
const toc = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout
  lang={lang}
  title={data.title}
  description={data.description}
  image={data.image}
  type="article"
  publishedDate={data.pubDate}
  modifiedDate={data.updatedDate}
  tags={data.tags}
>
  <article class="py-12 md:py-16">
    <div class="container-prose">
      <a
        href={localizePath(lang, 'blog')}
        class="group inline-flex items-center gap-1.5 font-mono text-sm text-muted transition-colors hover:text-[var(--text-primary)]"
      >
        <span class="transition-transform group-hover:-translate-x-0.5" aria-hidden="true">←</span>
        {t('blog.back')}
      </a>

      <header class="mt-8">
        <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-muted">
          <time datetime={data.pubDate.toISOString()}>
            {formatDate(data.pubDate, lang)}
          </time>
          <span aria-hidden="true">·</span>
          <span>{data.readTime} {t('blog.readTime')}</span>
          {
            data.updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  {t('blog.updated')} {formatDate(data.updatedDate, lang)}
                </span>
              </>
            )
          }
        </div>

        <h1
          class="mt-4 text-[length:clamp(2rem,4.5vw,3.25rem)] leading-[1.1] font-bold tracking-[-0.03em] text-balance"
        >
          {data.title}
        </h1>

        <p class="mt-5 text-lg leading-relaxed text-secondary text-pretty">
          {data.description}
        </p>

        {
          data.tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-1.5">
              {data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )
        }
      </header>
    </div>

    {
      data.image && (
        <div class="container-prose mt-12">
          <img
            src={data.image}
            alt=""
            class="w-full rounded-[var(--radius-card)] border border-subtle"
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }

    <div class="container-page mt-12 grid gap-12 lg:grid-cols-[16rem_minmax(0,46rem)] lg:justify-center">
      {
        toc.length > 2 && (
          <aside class="hidden lg:block lg:sticky lg:top-24 lg:self-start">
            <p class="eyebrow">{data.title.slice(0, 0) || 'Contents'}</p>
            <nav class="mt-3 flex flex-col gap-2 border-l border-subtle pl-4">
              {toc.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class="text-sm leading-snug text-muted transition-colors hover:text-[var(--text-primary)]"
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </aside>
        )
      }

      <div class="prose prose-lg min-w-0 lg:col-start-2">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
