---
import BaseLayout from '@layouts/BaseLayout.astro';
import BreadcrumbList from '@components/BreadcrumbList.astro';
import ServiceAreaCard from '@components/ServiceAreaCard.astro';
import { PROFILE } from '@/config';
import { serviceAreas } from '@/data/offerings';
import { languages, localizePath, useTranslations, type Lang } from '@i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const availability = PROFILE.bookingFrom ?? t('services.availabilityFallback');

const breadcrumbs = [
  { name: t('nav.home'), href: localizePath(lang) },
  { name: t('nav.services'), href: localizePath(lang, 'services') },
];
---

<BaseLayout
  lang={lang}
  title={t('seo.servicesTitle')}
  description={t('services.positioning')}
>
  <BreadcrumbList items={breadcrumbs} />

  <div class="container-page py-16 md:py-24">
    <header class="max-w-2xl">
      <p class="eyebrow">{t('services.title')}</p>
      <h1
        class="mt-3 text-[length:var(--text-hero)] leading-[1.05] font-bold tracking-[-0.03em] text-balance"
      >
        {t('services.title')}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-secondary text-pretty">
        {t('services.positioning')}
      </p>
    </header>

    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {serviceAreas.map((area) => <ServiceAreaCard area={area} lang={lang} variant="full" />)}
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      <div class="surface-card p-6">
        <p class="eyebrow text-[11px]">{t('services.availability')}</p>
        <p class="mt-2 text-lg font-semibold">{availability}</p>

        {
          /* The floor line is omitted entirely rather than guessed — publishing
             a wrong number is worse than publishing none. Set PROFILE.engagementFloor. */
          PROFILE.engagementFloor && (
            <>
              <p class="eyebrow mt-6 text-[11px]">{t('services.floorLabel')}</p>
              <p class="mt-2 text-lg font-semibold">
                {PROFILE.engagementFloor}
              </p>
              <p class="mt-2 text-sm text-muted">{t('services.floorNote')}</p>
            </>
          )
        }

        <p class="mt-6 border-t border-subtle pt-6 text-sm text-secondary">
          {t('services.antiAgency')}
        </p>
      </div>

      <div
        class="surface-card relative flex flex-col justify-between overflow-hidden p-6"
      >
        <div
          class="pointer-events-none absolute -top-20 -right-16 h-48 w-48 rounded-full bg-[var(--accent)] opacity-20 blur-[80px]"
          aria-hidden="true"
        >
        </div>
        <div>
          <p class="eyebrow">{t('contact.projectColumn')}</p>
          <p class="mt-3 leading-relaxed text-secondary">
            {t('contact.projectDesc')}
          </p>
          <a href={localizePath(lang, 'how-i-work')} class="link-accent mt-4 inline-block text-sm">
            {t('nav.howIWork')} →
          </a>
        </div>
        <a
          href={localizePath(lang, 'contact')}
          class="btn-primary mt-8 w-full justify-center"
        >
          {t('hero.ctaPrimary')}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
