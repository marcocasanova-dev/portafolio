---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ProjectCarousel from '@components/ProjectCarousel.astro';
import DecisionExcerpts from '@components/DecisionExcerpts.astro';
import ClientMarquee from '@components/ClientMarquee.astro';
import ServiceAreaCard from '@components/ServiceAreaCard.astro';
import EngagementFormatCard from '@components/EngagementFormatCard.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import Faq from '@components/Faq.astro';
import { getFeaturedProjects } from '@/lib/content';
import { problems, serviceAreas, engagementFormats } from '@/data/offerings';
import { SITE } from '@/config';
import { localizePath, useTranslations, type Lang, languages } from '@i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const featuredProjects = await getFeaturedProjects(lang, 3);

/*
 * Freelance-first order (see CONTENT_TODO.md / project brief): hero, proof,
 * problems solved, services, engagement formats, case studies + decisions,
 * process, FAQ, final CTA. Testimonials are intentionally omitted — no
 * genuine reference content exists yet to publish.
 */
---

<BaseLayout
  lang={lang}
  title={t('seo.homeTitle')}
  description={t('seo.homeDescription')}
>
  <Hero lang={lang} />

  <ClientMarquee title={t('home.clients')} />

  <section class="container-page reveal py-16 md:py-20">
    <SectionHeading title={t('home.problemsHeading')} subtitle={t('home.problemsSub')} />
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        problems.map((problem) => (
          <div class="surface-card p-6">
            <h3 class="font-semibold tracking-tight">{problem.title[lang]}</h3>
            <p class="mt-3 text-sm leading-relaxed text-secondary">{problem.body[lang]}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container-page reveal py-16 md:py-20">
    <SectionHeading
      title={t('home.servicesHeading')}
      subtitle={t('home.servicesSub')}
      actionLabel={t('home.servicesCta')}
      actionHref={localizePath(lang, 'services')}
    />
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {serviceAreas.map((area) => <ServiceAreaCard area={area} lang={lang} />)}
    </div>
  </section>

  <section class="container-page reveal py-16 md:py-20">
    <SectionHeading
      title={t('home.formatsHeading')}
      subtitle={t('home.formatsSub')}
      actionLabel={t('home.formatsCta')}
      actionHref={localizePath(lang, 'how-i-work')}
    />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {engagementFormats.map((format) => <EngagementFormatCard format={format} lang={lang} />)}
    </div>
  </section>

  <section class="container-page reveal py-16 md:py-20">
    <SectionHeading
      title={t('home.selectedWork')}
      subtitle={t('home.selectedWorkSub')}
      actionLabel={t('home.viewAllWork')}
      actionHref={localizePath(lang, 'work')}
    />

    <ProjectCarousel projects={featuredProjects} lang={lang} />

    {/* Verbatim reasoning pulled from the same three case studies above. */}
    <DecisionExcerpts projects={featuredProjects} lang={lang} />
  </section>

  <section class="container-page reveal py-16 md:py-20">
    <SectionHeading title={t('home.processHeading')} subtitle={t('home.processSub')} />
    <ProcessSteps lang={lang} />
  </section>

  <section id="faq" class="container-page reveal py-16 md:py-20">
    <SectionHeading title={t('home.faqHeading')} subtitle={t('home.faqSub')} />
    <Faq lang={lang} />
  </section>

  <section class="container-page reveal py-16 md:py-20">
    <div
      class="surface-card relative overflow-hidden px-6 py-14 text-center md:px-12"
    >
      <div
        class="pointer-events-none absolute -top-24 left-1/2 h-48 w-96 -translate-x-1/2 rounded-full bg-[var(--accent)] opacity-20 blur-[100px]"
        aria-hidden="true"
      >
      </div>
      <h2 class="text-[length:var(--text-section)] font-bold tracking-tight text-balance">
        {t('contact.heading')}
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-secondary text-pretty">
        {t('home.finalCtaSub')}
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={SITE.calendly}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          {t('contact.callLabel')}
          <span aria-hidden="true">↗</span>
        </a>
        <a href={localizePath(lang, 'contact')} class="link-accent text-sm">
          {t('nav.contact')} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
