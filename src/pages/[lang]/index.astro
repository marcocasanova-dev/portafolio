---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ProjectShowcase from '@components/ProjectShowcase.astro';
import DecisionExcerpts from '@components/DecisionExcerpts.astro';
import Testimonials from '@components/Testimonials.astro';
import ClientMarquee from '@components/ClientMarquee.astro';
import ServiceAreaCard from '@components/ServiceAreaCard.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import { getFeaturedProjects } from '@/lib/content';
import { problems, serviceAreas } from '@/data/offerings';
import { testimonials } from '@/data/testimonials';
import { localizePath, useTranslations, type Lang, languages } from '@i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const featuredProjects = await getFeaturedProjects(lang, 3);
const showcaseProjects = await getFeaturedProjects(lang, 4);

/*
 * Eight-section order, deliberately short and decisive: hero, proof, problems
 * solved, three services, three featured case studies, real testimonials or
 * alternative proof (verbatim decision quotes — used only while
 * src/data/testimonials.ts is empty), a simple process, final CTA.
 * Engagement formats and FAQ live on /how-i-work instead of repeating here —
 * see that page for "how you buy the work"; this page only needs to
 * establish "why buy it from Marco."
 */
---

<BaseLayout
  lang={lang}
  title={t('seo.homeTitle')}
  description={t('seo.homeDescription')}
>
  <Hero lang={lang} />

  <ClientMarquee title={t('home.clients')} disclosure={t('home.clientsDisclosure')} />

  <section class="container-page reveal py-16 md:py-20">
    <SectionHeading title={t('home.problemsHeading')} subtitle={t('home.problemsSub')} />
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        problems.map((problem) => (
          <div class="surface-card p-6">
            <h3 class="font-semibold tracking-tight">{problem.title[lang]}</h3>
            <p class="mt-3 text-sm leading-relaxed text-secondary">{problem.body[lang]}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container-page reveal py-16 md:py-20">
    <SectionHeading
      title={t('home.servicesHeading')}
      subtitle={t('home.servicesSub')}
      actionLabel={t('home.servicesCta')}
      actionHref={localizePath(lang, 'services')}
    />
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {serviceAreas.map((area) => <ServiceAreaCard area={area} lang={lang} />)}
    </div>
  </section>

  <section class="container-page reveal py-16 md:py-20">
    <SectionHeading
      title={t('home.selectedWork')}
      subtitle={t('home.selectedWorkSub')}
      actionLabel={t('home.viewAllWork')}
      actionHref={localizePath(lang, 'work')}
    />

    <div class="mt-10 grid gap-6">
      {showcaseProjects.map((project, i) => <ProjectShowcase project={project} lang={lang} index={i + 1} />)}
    </div>
  </section>

  {/*
    "Testimonials or alternative proof": no genuine, permission-confirmed
    client testimonials exist yet (see src/data/testimonials.ts), so this
    section falls back to verified project evidence instead — verbatim
    reasoning pulled word-for-word from the same three case studies above,
    not a new summary. The moment a real testimonial is added to that file,
    this section switches to showing it instead, with no page-structure
    changes needed.
  */}
  {
    testimonials.length > 0 ? (
      <section class="container-page reveal py-16 md:py-20">
        <SectionHeading
          title={t('home.testimonialsHeading')}
          subtitle={t('home.testimonialsSub')}
        />
        <Testimonials lang={lang} />
      </section>
    ) : (
      <section class="container-page reveal py-16 md:py-20">
        <SectionHeading title={t('home.decisions')} subtitle={t('home.decisionsSub')} />
        <DecisionExcerpts projects={featuredProjects} lang={lang} />
      </section>
    )
  }

  <section class="container-page reveal py-16 md:py-20">
    <SectionHeading title={t('home.processHeading')} subtitle={t('home.processSub')} />
    <ProcessSteps lang={lang} />
  </section>

  <section class="container-page reveal py-16 md:py-20">
    <div
      class="surface-card relative overflow-hidden px-6 py-14 text-center md:px-12"
    >
      <div
        class="pointer-events-none absolute -top-24 left-1/2 h-48 w-96 -translate-x-1/2 rounded-full bg-[var(--accent)] opacity-20 blur-[100px]"
        aria-hidden="true"
      >
      </div>
      <h2 class="text-[length:var(--text-section)] font-bold tracking-tight text-balance">
        {t('contact.heading')}
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-secondary text-pretty">
        {t('home.finalCtaSub')}
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={localizePath(lang, 'contact')} class="btn-primary">
          {t('hero.ctaPrimary')}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
