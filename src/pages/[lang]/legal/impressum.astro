---
import BaseLayout from '@layouts/BaseLayout.astro';
import Todo from '@components/Todo.astro';
import { PROFILE, SITE } from '@/config';
import { languages, localizePath, useTranslations, type Lang } from '@i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

/**
 * German DDG §5 (Digitale-Dienste-Gesetz, in force since May 2024 and
 * replacing the former TMG §5) requires an Impressum on every commercial
 * site regardless of the visitor's language, so the legal name of this page
 * ("Impressum") and its statutory content stay the same across locales,
 * only the surrounding chrome (nav labels) is translated.
 *
 * The EU's former Online Dispute Resolution (ODR) platform was discontinued
 * on 20 July 2025 (Regulation (EU) 2024/3228); the dispute-resolution
 * section below points to its replacement directory instead.
 *
 * NOT reviewed by a lawyer — see CONTENT_VERIFICATION.md for the private
 * handoff note. Do not treat this as legal advice.
 */
const copy: Record<
  Lang,
  { title: string; intro: string; contactHeading: string; contentHeading: string; contentBody: string; disputeHeading: string; disputeBody: string; liabilityHeading: string; liabilityBody: string; linksHeading: string; linksBody: string }
> = {
  en: {
    title: 'Impressum',
    intro: 'Legal disclosure pursuant to § 5 DDG (German Digital Services Act).',
    contactHeading: 'Provider',
    contentHeading: 'Responsible for content',
    contentBody: 'Responsible for content pursuant to § 18 Abs. 2 MStV: Marco Casanova, address as above.',
    disputeHeading: 'Dispute resolution',
    disputeBody:
      "The European Commission's former Online Dispute Resolution (ODR) platform was discontinued on 20 July 2025. The EU now maintains a directory of consumer dispute-resolution bodies at https://consumer-redress.ec.europa.eu/dispute-resolution-bodies. I am not obliged and not willing to participate in dispute resolution proceedings before a consumer arbitration board.",
    liabilityHeading: 'Liability for content',
    liabilityBody:
      'As a service provider, I am responsible for my own content on these pages under general law. § 7 DDG (which implements the EU Digital Services Act, Regulation (EU) 2022/2065) limits my liability for illegal third-party content on this site that I merely transmit or host, unless I knowingly collaborate in it.',
    linksHeading: 'Liability for links',
    linksBody:
      'This site links to external third-party websites whose content I have no influence over. I therefore cannot accept any liability for this external content. The respective provider or operator of the linked pages is always responsible for their content.',
  },
  de: {
    title: 'Impressum',
    intro: 'Angaben gemäß § 5 DDG (Digitale-Dienste-Gesetz).',
    contactHeading: 'Anbieter',
    contentHeading: 'Verantwortlich für den Inhalt',
    contentBody: 'Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV: Marco Casanova, Anschrift wie oben.',
    disputeHeading: 'Streitschlichtung',
    disputeBody:
      'Die frühere Online-Streitbeilegungsplattform der Europäischen Kommission wurde zum 20. Juli 2025 eingestellt. Die EU führt seither ein Verzeichnis der Verbraucherschlichtungsstellen unter https://consumer-redress.ec.europa.eu/dispute-resolution-bodies. Ich bin nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.',
    liabilityHeading: 'Haftung für Inhalte',
    liabilityBody:
      'Als Diensteanbieter bin ich für eigene Inhalte auf diesen Seiten nach den allgemeinen Gesetzen verantwortlich. § 7 DDG (zur Umsetzung des Digital Services Act, Verordnung (EU) 2022/2065) beschränkt meine Haftung für rechtswidrige fremde Inhalte auf dieser Seite, die ich lediglich übermittle oder hoste, sofern ich nicht wissentlich daran mitwirke.',
    linksHeading: 'Haftung für Links',
    linksBody:
      'Diese Seite enthält Links zu externen Webseiten Dritter, auf deren Inhalte ich keinen Einfluss habe. Deshalb kann ich für diese fremden Inhalte auch keine Gewähr übernehmen. Für die Inhalte der verlinkten Seiten ist stets der jeweilige Anbieter oder Betreiber der Seiten verantwortlich.',
  },
  es: {
    title: 'Impressum',
    intro: 'Información legal según el § 5 DDG (ley alemana de servicios digitales).',
    contactHeading: 'Responsable',
    contentHeading: 'Responsable del contenido',
    contentBody: 'Responsable del contenido según el § 18 Abs. 2 MStV: Marco Casanova, dirección como se indica arriba.',
    disputeHeading: 'Resolución de conflictos',
    disputeBody:
      'La antigua plataforma de resolución de litigios en línea (ODR) de la Comisión Europea dejó de estar disponible el 20 de julio de 2025. La UE mantiene ahora un directorio de organismos de resolución de conflictos de consumo en https://consumer-redress.ec.europa.eu/dispute-resolution-bodies. No estoy obligado ni dispuesto a participar en procedimientos de resolución de conflictos ante una entidad de arbitraje de consumo.',
    liabilityHeading: 'Responsabilidad sobre el contenido',
    liabilityBody:
      'Como prestador de servicios, soy responsable de mis propios contenidos en este sitio conforme a la legislación general. El § 7 DDG (que implementa el Digital Services Act, Reglamento (UE) 2022/2065) limita mi responsabilidad por contenido ilícito de terceros en este sitio que simplemente transmita o aloje, salvo que colabore conscientemente en él.',
    linksHeading: 'Responsabilidad sobre enlaces',
    linksBody:
      'Este sitio enlaza a páginas externas de terceros sobre cuyo contenido no tengo ninguna influencia. Por ello no puedo asumir ninguna responsabilidad sobre dichos contenidos externos. La responsabilidad sobre el contenido de las páginas enlazadas corresponde siempre a su proveedor u operador.',
  },
};

const c = copy[lang];
---

<BaseLayout lang={lang} title={c.title} description={c.intro} noindex>
  <div class="container-prose py-16 md:py-24">
    <p class="eyebrow">{c.title}</p>
    <h1 class="mt-3 text-[length:var(--text-section)] font-bold tracking-tight">{c.title}</h1>
    <p class="mt-3 text-secondary">{c.intro}</p>

    <div class="prose prose-lg mt-10 max-w-none">
      <h2>{c.contactHeading}</h2>
      <p>
        {SITE.name}
        <br />
        <Todo value={PROFILE.legal.fullAddress} />
        <br />
        {PROFILE.city}, {PROFILE.country}
      </p>
      <p>
        E-Mail: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
      {
        PROFILE.legal.vatId && (
          <p>
            USt-IdNr.: {PROFILE.legal.vatId}
          </p>
        )
      }

      <h2>{c.contentHeading}</h2>
      <p>{c.contentBody}</p>

      <h2>{c.disputeHeading}</h2>
      <p>{c.disputeBody}</p>

      <h2>{c.liabilityHeading}</h2>
      <p>{c.liabilityBody}</p>

      <h2>{c.linksHeading}</h2>
      <p>{c.linksBody}</p>
    </div>

    <a href={localizePath(lang)} class="link-accent mt-14 inline-block text-sm">
      ← {t('legal.backHome')}
    </a>
  </div>
</BaseLayout>
