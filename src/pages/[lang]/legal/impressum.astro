---
import BaseLayout from '@layouts/BaseLayout.astro';
import Todo from '@components/Todo.astro';
import { PROFILE, SITE } from '@/config';
import { languages, localizePath, useTranslations, type Lang } from '@i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

/**
 * German TMG §5 requires an Impressum on every commercial site regardless of
 * the visitor's language, so the legal name of this page ("Impressum") and
 * its statutory content stay the same across locales, only the surrounding
 * chrome (nav labels, draft banner) is translated.
 */
const copy: Record<
  Lang,
  { title: string; intro: string; contactHeading: string; contentHeading: string; contentBody: string; disputeHeading: string; disputeBody: string; liabilityHeading: string; liabilityBody: string; linksHeading: string; linksBody: string }
> = {
  en: {
    title: 'Impressum',
    intro: 'Legal disclosure pursuant to § 5 TMG (German Telemedia Act).',
    contactHeading: 'Provider',
    contentHeading: 'Responsible for content',
    contentBody: 'Responsible for content pursuant to § 18 Abs. 2 MStV: Marco Casanova, address as above.',
    disputeHeading: 'Dispute resolution',
    disputeBody:
      'The European Commission provides a platform for online dispute resolution (ODR): https://ec.europa.eu/consumers/odr/. I am not obliged and not willing to participate in dispute resolution proceedings before a consumer arbitration board.',
    liabilityHeading: 'Liability for content',
    liabilityBody:
      'As a service provider, I am responsible for my own content on these pages under general law (§ 7 Abs. 1 TMG). Pursuant to §§ 8 to 10 TMG, however, I am not obliged to monitor transmitted or stored third-party information.',
    linksHeading: 'Liability for links',
    linksBody:
      'This site links to external third-party websites whose content I have no influence over. I therefore cannot accept any liability for this external content. The respective provider or operator of the linked pages is always responsible for their content.',
  },
  de: {
    title: 'Impressum',
    intro: 'Angaben gemäß § 5 TMG (Telemediengesetz).',
    contactHeading: 'Anbieter',
    contentHeading: 'Verantwortlich für den Inhalt',
    contentBody: 'Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV: Marco Casanova, Anschrift wie oben.',
    disputeHeading: 'Streitschlichtung',
    disputeBody:
      'Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit: https://ec.europa.eu/consumers/odr/. Ich bin nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.',
    liabilityHeading: 'Haftung für Inhalte',
    liabilityBody:
      'Als Diensteanbieter bin ich gemäß § 7 Abs. 1 TMG für eigene Inhalte auf diesen Seiten nach den allgemeinen Gesetzen verantwortlich. Nach §§ 8 bis 10 TMG bin ich jedoch nicht verpflichtet, übermittelte oder gespeicherte fremde Informationen zu überwachen.',
    linksHeading: 'Haftung für Links',
    linksBody:
      'Diese Seite enthält Links zu externen Webseiten Dritter, auf deren Inhalte ich keinen Einfluss habe. Deshalb kann ich für diese fremden Inhalte auch keine Gewähr übernehmen. Für die Inhalte der verlinkten Seiten ist stets der jeweilige Anbieter oder Betreiber der Seiten verantwortlich.',
  },
  es: {
    title: 'Impressum',
    intro: 'Información legal según el § 5 TMG (ley alemana de telemedios).',
    contactHeading: 'Responsable',
    contentHeading: 'Responsable del contenido',
    contentBody: 'Responsable del contenido según el § 18 Abs. 2 MStV: Marco Casanova, dirección como se indica arriba.',
    disputeHeading: 'Resolución de conflictos',
    disputeBody:
      'La Comisión Europea ofrece una plataforma de resolución de litigios en línea (ODR): https://ec.europa.eu/consumers/odr/. No estoy obligado ni dispuesto a participar en procedimientos de resolución de conflictos ante una entidad de arbitraje de consumo.',
    liabilityHeading: 'Responsabilidad sobre el contenido',
    liabilityBody:
      'Como prestador de servicios, soy responsable de mis propios contenidos en este sitio conforme a la legislación general (§ 7 Abs. 1 TMG). No obstante, según los §§ 8 a 10 TMG, no estoy obligado a supervisar información de terceros transmitida o almacenada.',
    linksHeading: 'Responsabilidad sobre enlaces',
    linksBody:
      'Este sitio enlaza a páginas externas de terceros sobre cuyo contenido no tengo ninguna influencia. Por ello no puedo asumir ninguna responsabilidad sobre dichos contenidos externos. La responsabilidad sobre el contenido de las páginas enlazadas corresponde siempre a su proveedor u operador.',
  },
};

const c = copy[lang];
---

<BaseLayout lang={lang} title={c.title} description={c.intro} noindex>
  <div class="container-prose py-16 md:py-24">
    <p
      class="rounded-lg border border-amber-500/50 bg-amber-500/10 px-4 py-3 text-sm text-amber-700 dark:text-amber-400"
    >
      ⚠ {t('legal.draftBanner')}
    </p>

    <p class="eyebrow mt-10">{c.title}</p>
    <h1 class="mt-3 text-[length:var(--text-section)] font-bold tracking-tight">{c.title}</h1>
    <p class="mt-3 text-secondary">{c.intro}</p>

    <div class="prose prose-lg mt-10 max-w-none">
      <h2>{c.contactHeading}</h2>
      <p>
        {SITE.name}
        <br />
        <Todo value={PROFILE.legal.fullAddress} />
        <br />
        {PROFILE.city}, {PROFILE.country}
      </p>
      <p>
        E-Mail: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
      {
        PROFILE.legal.vatId && (
          <p>
            USt-IdNr.: {PROFILE.legal.vatId}
          </p>
        )
      }

      <h2>{c.contentHeading}</h2>
      <p>{c.contentBody}</p>

      <h2>{c.disputeHeading}</h2>
      <p>{c.disputeBody}</p>

      <h2>{c.liabilityHeading}</h2>
      <p>{c.liabilityBody}</p>

      <h2>{c.linksHeading}</h2>
      <p>{c.linksBody}</p>
    </div>

    <a href={localizePath(lang)} class="link-accent mt-14 inline-block text-sm">
      ← {t('legal.backHome')}
    </a>
  </div>
</BaseLayout>
