---
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations } from '@i18n/utils';

// A single 404 serves both locales — GitHub Pages only honours one 404.html,
// so it links to both language homepages rather than guessing.
const t = useTranslations('en');
const tEs = useTranslations('es');
const tDe = useTranslations('de');
---

<BaseLayout
  lang="en"
  title={t('404.title')}
  description={t('404.subtitle')}
  noindex
>
  <div class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-mono text-7xl font-bold text-[var(--accent)]">404</p>

    <h1 class="mt-6 text-[length:var(--text-section)] font-bold tracking-tight">
      {t('404.title')}
    </h1>
    <p class="mt-3 max-w-md text-secondary">{t('404.subtitle')}</p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/en" class="btn-primary">{t('404.cta')}</a>
      <a href="/es" class="btn-secondary">{tEs('404.cta')}</a>
      <a href="/de" class="btn-secondary">{tDe('404.cta')}</a>
    </div>
  </div>
</BaseLayout>
